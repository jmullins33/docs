            "pages": [
              "concepts/predictive-models",
              "concepts/track-conditions",
              "concepts/driver-metrics"
            ]
          },
          {
            "group": "Odds & Risk",
            "pages": [
              "analytics/race-predictions",
              "analytics/weather-integration",
              "analytics/historical-data",
              "analytics/real-time-insights"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Predictions",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.dirtiq.com",
          "icon": "chart-mixed"
        },
        {
          "anchor": "Community",
          "href": "https://community.dirtiq.com",
          "icon": "discord"
        }
      ]
    }
